# Data files (large - exclude from repo)
*.csv
*.parquet
data_sources/
dataset_*.csv

# Model artifacts
*.pkl
output/*.pkl
storage/models/*.pkl

# Keep specific test files
!test.json
!requirements.json
!package.json

# Logs and temporary output
logs/*
!logs/.gitkeep
output/*
!output/.gitkeep

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/
.venv
securebank/venv/

